# Copy to .env and fill in (never commit .env)
# qud = QUD³ Quranic Universal Aligner (keyless, phoneme-level); falls back to
# QUD_FALLBACK (groq) on quota/outage. ASR_BACKEND=groq forces the old path.
ASR_BACKEND=qud
QUD_URL=https://aligner.qud.dev/api/v1
QUD_DEVICE=GPU
QUD_MODEL=Base
QUD_RIWAYAH=hafs
QUD_TIMEOUT=900
QUD_FALLBACK=groq
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2
